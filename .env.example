# Sources are loaded from feeds.json (priority: NEWS_SOURCES env > feeds.json > DEFAULT_SOURCES)
OUTPUT_DIR=public/news
TIMEZONE=Asia/Shanghai
USER_AGENT=PersonalNewsDigestBot/1.0
REQUEST_TIMEOUT=15
MAX_ARTICLES_PER_SOURCE=20
BASE_URL=https://<your-github-username>.github.io/<repo-name>

ENABLE_LLM_ANALYSIS=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
OPENAI_TIMEOUT=90

ENABLE_SUPABASE_BACKUP=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_DIGESTS=news_digests
SUPABASE_TABLE_ARTICLES=news_articles
